{
    "type": "panel",
    "i18n": true,
    "items": {
        "mqttPort": {
            "type": "number",
            "label": "MQTT port",
            "help": "Port used by the integrated MQTT broker",
            "min": 1,
            "max": 65535,
            "default": 1883,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "mqttUsername": {
            "type": "text",
            "label": "MQTT username",
            "help": "Username used by the Nuki Smart Lock",
            "default": "nuki",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "mqttPassword": {
            "type": "password",
            "label": "MQTT password",
            "help": "Password used by the Nuki Smart Lock",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "webApiEnabled": {
            "type": "checkbox",
            "label": "Enable Nuki Web API",
            "help": "Enable additional cloud data such as users, authorizations and activity logs",
            "default": false,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "webApiToken": {
            "type": "password",
            "label": "Nuki Web API token",
            "help": "Personal API token used to access the Nuki Web API",
            "hidden": "!data.webApiEnabled",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "webApiInterval": {
            "type": "number",
            "label": "Web API update interval",
            "help": "Interval in seconds for updating Nuki Web API data",
            "min": 60,
            "max": 86400,
            "default": 300,
            "hidden": "!data.webApiEnabled",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6
        },
        "keypadUsers": {
            "type": "table",
            "label": "Keypad / Fingerprint users",
            "help": "Assign Nuki Code IDs to user names. The Code ID can be found in the lockActionEvent MQTT message.",
            "newLine": true,
            "items": [
                {
                    "type": "number",
                    "attr": "codeId",
                    "title": "Code ID",
                    "width": "30%",
                    "sort": true,
                    "filter": false,
                    "default": 0
                },
                {
                    "type": "text",
                    "attr": "name",
                    "title": "Name",
                    "width": "70%",
                    "sort": true,
                    "filter": false,
                    "default": ""
                }
            ]
        }
    }
}
